{
  "manifest_version": 3,
  "name": "Tab Wiz",
  "version": "0.1.0",
  "description": "Keyboard-first tab organiser with user-defined categories.",
  "permissions": ["tabs", "storage", "history"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-tab-wiz": {
      "suggested_key": {
        "mac": "Command+Shift+Space",
        "windows": "Ctrl+Shift+Space",
        "linux": "Ctrl+Shift+Space"
      },
      "description": "Open Tab Wiz"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
